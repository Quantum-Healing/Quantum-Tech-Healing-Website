{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quantum-tech-healing-website",
  "main": "Quantum Tech/video-worker.js",
  "compatibility_date": "2026-11-16",
  "assets": {
    "directory": "./Quantum Tech/site",
    "binding": "ASSETS",
    "run_worker_first": ["/videos/*"]
  }
}
